<?xml version="1.0" encoding="UTF-8"?>
<backgrounds>
	<background name="custom-image" label="Set single image background" type="browse">
		<icon>special://skin/extras/icons/DefaultPicture.png</icon>
		<source label="$LOCALIZE[1024]">browse</source>
		<source label="Skin Backgrounds">special://skin/extras/backgrounds/</source>
	</background>
	<background name="custom-folder" label="Set multi-image background" type="multi">
		<icon>special://skin/extras/icons/DefaultFolder.png</icon>
		<source label="$LOCALIZE[1024]">browse</source>
		<source label="Skin Backgrounds">special://skin/extras/backgrounds/</source>
	</background>
	<group name="skininfo-fanart" icon="logos/skininfo-logo.png" label="$INFO[System.AddonTitle(script.skin.info.service)]" visible="System.AddonIsEnabled(script.skin.info.service)">
		<background name="movie-fanart" label="Random movie fanart" type="property" visible="System.AddonIsEnabled(script.skin.info.service) + Library.HasContent(movies)">
			<path>$INFO[Window(Home).Property(SkinInfo.Slideshow.Movie.FanArt)]</path>
			<icon>special://skin/extras/icons/DefaultMovies.png</icon>
		</background>
		<background name="tv-fanart" label="Random TV show fanart" type="property" visible="System.AddonIsEnabled(script.skin.info.service) + Library.HasContent(tvshows)">
			<path>$INFO[Window(Home).Property(SkinInfo.Slideshow.TV.FanArt)]</path>
			<icon>special://skin/extras/icons/DefaultTVShows.png</icon>
		</background>
		<background name="video-fanart" label="Random video fanart" type="property" visible="System.AddonIsEnabled(script.skin.info.service)">
			<path>$INFO[Window(Home).Property(SkinInfo.Slideshow.Video.FanArt)]</path>
			<icon>special://skin/extras/icons/DefaultVideo.png</icon>
		</background>
		<background name="music-fanart" label="Random music fanart" type="property" visible="System.AddonIsEnabled(script.skin.info.service) + Library.HasContent(music)">
			<path>$INFO[Window(Home).Property(SkinInfo.Slideshow.Music.FanArt)]</path>
			<icon>special://skin/extras/icons/DefaultAudio.png</icon>
		</background>
		<background name="global-fanart" label="Random fanart" type="property" visible="System.AddonIsEnabled(script.skin.info.service)">
			<path>$INFO[Window(Home).Property(SkinInfo.Slideshow.Global.FanArt)]</path>
			<icon>special://skin/extras/icons/DefaultPicture.png</icon>
		</background>
	</group>
	<group name="kodi-fanart" icon="logos/kodi.png" label="Kodi fanart">
		<background name="kodi-movie-fanart" label="Kodi random movie fanart" type="property" visible="Library.HasContent(movies)">
			<path>$INFO[Container(9035).ListItem.Art(fanart)]</path>
			<icon>special://skin/extras/icons/DefaultMovies.png</icon>
		</background>
		<background name="kodi-tv-fanart" label="Kodi random TV show fanart" type="property" visible="Library.HasContent(tvshows)">
			<path>$INFO[Container(9036).ListItem.Art(fanart)]</path>
			<icon>special://skin/extras/icons/DefaultTVShows.png</icon>
		</background>
		<background name="kodi-music-fanart" label="Kodi random music fanart" type="property" visible="Library.HasContent(music)">
			<path>$INFO[Container(9037).ListItem.Art(fanart)]</path>
			<icon>special://skin/extras/icons/DefaultAudio.png</icon>
		</background>
		<background name="kodi-musicvideo-fanart" label="Kodi random music video fanart" type="property" visible="Library.HasContent(musicvideos)">
			<path>$INFO[Container(9038).ListItem.Art(fanart)]</path>
			<icon>special://skin/extras/icons/DefaultMusicVideos.png</icon>
		</background>
	</group>
	<background name="weather-fanart" label="Conditional weather" type="property" visible="!String.IsEmpty(Skin.String(weatherfanart.path))">
		<path>$INFO[Skin.String(weatherfanart.path)]$INFO[Window(Weather).Property(Current.FanartCode)]$VAR[WeatherBackgroundTypeVar]</path>
		<icon>special://skin/extras/icons/DefaultAddonWeather.png</icon>
	</background>
	<background name="playlist" label="$LOCALIZE[136] >" type="playlist">
		<icon>DefaultPlaylist.png</icon>
		<source label="Skin Playlists" icon="DefaultPlaylist.png">special://skin/extras/playlists/</source>
		<source label="$LOCALIZE[20012]" icon="DefaultVideoPlaylists.png">special://videoplaylists/</source>
		<source label="$LOCALIZE[20011]" icon="DefaultMusicPlaylists.png">special://musicplaylists/</source>
	</background>
	<background name="live-playlist" label="Live Backgrounds >" type="live-playlist">
		<icon>DefaultPlaylist.png</icon>
		<source label="Skin Playlists" icon="DefaultPlaylist.png">special://skin/extras/playlists/</source>
		<source label="$LOCALIZE[20012]" icon="DefaultVideoPlaylists.png">special://videoplaylists/</source>
		<source label="$LOCALIZE[20011]" icon="DefaultMusicPlaylists.png">special://musicplaylists/</source>
	</background>
</backgrounds>
